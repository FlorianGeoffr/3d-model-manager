# Copy this file to `.env` before running `docker compose up` (see README
# "Quickstart"). Every TDMM_ variable is read by the app via
# pydantic-settings with the `TDMM_` prefix (backend/app/config.py).

# --- Container privilege drop (Task 9) -------------------------------------
# Unset by default: the api/worker containers run as root (unchanged M1
# choice). Set BOTH to your host user's `id -u`/`id -g` to have the
# entrypoint drop to that uid/gid instead, so files written under the
# bind-mounted ./library aren't root-owned on the host.
#PUID=1000
#PGID=1000

# --- Database -----------------------------------------------------------
# Points at the `db` compose service. The embedded user/password/dbname
# MUST match the `db` service's POSTGRES_* environment in compose.yaml.
TDMM_DATABASE_URL=postgresql+asyncpg://tdmm:tdmm@db:5432/tdmm

# --- Redis (Celery broker/results + SSE pub/sub) -------------------------
TDMM_REDIS_URL=redis://redis:6379/0

# --- Storage --------------------------------------------------------------
# Paths as seen INSIDE the api/worker containers (compose mounts these).
TDMM_LIBRARY_ROOT=/library
TDMM_DATA_DIR=/data

# Storage backends (M3): the active backend -- local (default), SMB, or S3
# -- is NOT configured here. It's selected and configured from the running
# app's Settings > Storage UI (connection-tested before it takes effect,
# with a local->X migration helper to copy existing content over). There is
# always exactly one active backend, stored in the `settings` table.
#
# SMB: address the NAS by IP or a real, resolvable DNS name (never a bare
# mDNS/.local/NetBIOS name -- the container's resolver won't find it). For
# a LAN-only DNS name, add it to the `api`/`worker-io`/`worker-cpu` services
# in compose.yaml, e.g.:
#   extra_hosts:
#     - "nas.lan:192.168.1.50"
#
# Scheduled scan: opt-in periodic `scan_library` runs via Celery beat.
# Set this to a positive number of seconds AND start compose with
# `--profile beat` (see compose.yaml's `beat` service) -- leaving either
# unset/0 means no automatic scans, only ones triggered from Settings.
#TDMM_SCAN_INTERVAL_S=3600

# --- Printer integration (M4, Bambu LAN, feature-flagged) ------------------
# OFF by default: the whole app is fully functional without it (the printers
# API 503s, the Printer nav hides). Set true AND start the printerd service
# (`docker compose --profile printer up -d`) to enable it. Requires the
# printer in LAN-only + Developer Mode (see README "Printer integration").
#TDMM_PRINTER_ENABLED=false
#
# Fernet key for the printer access code at rest. Leave unset to let the app
# generate + persist one at ${TDMM_DATA_DIR}/secrets/printer.key (0600),
# shared across api/worker/printerd via the tdmm_data volume. Set it here
# instead (a urlsafe-base64 32-byte key) to supply your own.
#TDMM_PRINTER_KEY=

# --- Watched-folder auto-import (Round 8 Task 5) ---------------------------
# Periodically imports Bambu Studio (or any slicer's) exported files dropped
# into a watched folder, resolving each to a model the same way
# `POST /api/slicer/intake` does (see scripts/bambu_postprocess.py for the
# post-processing-script alternative, which doesn't need this at all).
# `TDMM_SLICER_WATCH_DIR` itself is NOT set here -- compose.yaml already sets
# it to `/watch` inside the `worker-io` container; leave it alone.
#
# Requires BOTH a positive interval below AND the `beat` profile running
# (e.g. `COMPOSE_PROFILES=printer,beat docker compose up -d`, or
# `docker compose --profile beat up -d`) -- leaving either unset/0 means no
# automatic imports.
#TDMM_SLICER_WATCH_INTERVAL_S=30
# A dropped file's mtime must be at least this many seconds old before it's
# imported, so a still-being-written export isn't picked up mid-write.
#TDMM_SLICER_WATCH_STABLE_S=10
# Host directory bind-mounted at `/watch` inside `worker-io` (compose.yaml) --
# point your slicer's export/sync target at this path. Must be writable by
# PUID/PGID: imported/unsupported files are moved into `.imported/`/
# `.failed/` subdirectories under it in place.
#TDMM_SLICER_WATCH_HOST_DIR=./slicer-watch

# --- SPA static files -----------------------------------------------------
# Where the built frontend lives inside the image. The Dockerfile already
# sets this by default (ENV TDMM_STATIC_DIR=/app/static); it's spelled out
# here for documentation. Leave unset for local `uv run uvicorn`
# development -- the Vite dev server serves the frontend there instead.
TDMM_STATIC_DIR=/app/static

# --- Auth -----------------------------------------------------------------
# Change this to a random value for anything beyond local experimentation.
TDMM_SECRET_KEY=change-me-to-a-random-value
TDMM_ADMIN_USERNAME=admin
# Leave TDMM_ADMIN_PASSWORD unset (commented out) on first run: the api
# container generates a random password and prints it ONCE to its logs
# (`docker compose logs api`) -- copy it down immediately, it's not
# recoverable after that. Set it explicitly here instead to pin a known
# password (e.g. for scripting -- scripts/e2e.sh requires this).
#TDMM_ADMIN_PASSWORD=

# Set true when the api is served over HTTPS (e.g. behind a TLS-terminating
# reverse proxy) so the session cookie gets the `Secure` flag.
TDMM_COOKIE_SECURE=false

# --- SSE (Server-Sent Events) -----------------------------------------------
# How often GET /api/events sends a `: ping` heartbeat comment while idle (seconds).
#TDMM_SSE_HEARTBEAT_INTERVAL_S=15

# --- Processing pipeline (M2) -----------------------------------------------
# Path/name of the gltfpack binary (optimize_glb step's meshopt compression).
# Leave unset -- the Docker image source-builds gltfpack onto PATH (Task 10),
# so the default of plain "gltfpack" already resolves. Local dev instead runs
# scripts/fetch-gltfpack.sh (see README "Development") and relies on the same
# PATH resolution rather than setting this.
#TDMM_GLTFPACK_PATH=gltfpack

# TDMM_QUEUES / TDMM_CONCURRENCY / TDMM_MAX_TASKS_PER_CHILD /
# TDMM_MAX_MEMORY_PER_CHILD_KB are compose-managed (set directly in
# compose.yaml's per-service `environment:`, one set for `worker-io`, a
# different set for `worker-cpu`) -- do not set them here, .env is shared by
# every service.
